sync_touchstone_repos() {
  local repos=(
    "touchstone-agent-webservice"
    "touchstone-CLI"
    "touchstone-doc"
    "touchstone-externals"
    "touchstone-package"
    "touchstone-web"
    "touchstone-api"
    "touchstone-common"
    "touchstone-engine"
    "touchstone-management-portal"
    "touchstone-ui"
  )

  for repo in "${repos[@]}"; do
    cd "$repo" || {
      echo -e "${RED}ERROR: Could not enter repo — $repo${NC}"
      continue
    }

    echo -e "${CYAN}###### Inside repo — $repo ######${NC}"

    if ! git checkout main; then
      echo -e "${RED}ERROR: Failed to checkout main — $repo${NC}"
      cd ..
      continue
    fi

    if ! git pull; then
      echo -e "${RED}ERROR: Failed to pull — $repo${NC}"
      cd ..
      continue
    fi

    echo -e "${GREEN}Successfully pulled main branch — $repo${NC}"

    cd ..
  done
}

move_cursor() {
  while true; do
    cliclick m:+0,+100
    sleep 0.5
    cliclick m:+100,+0
    sleep 0.5
    cliclick m:+0,-100
    sleep 0.5
    cliclick m:-100,+0
    sleep 5
  done 
}

alias mocr='move_cursor'

alias sync_repos='sync_touchstone_repos'
